{
  "name": "crm-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint . && prettier --check . && node scripts/check-generated.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run --typecheck",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "gen:api": "openapi-typescript --redocly redocly.yaml && openapi-typescript --redocly test-fixtures/openapi/redocly.yaml",
    "e2e": "playwright test --project=chromium"
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.1",
    "@tanstack/react-query": "5.104.3",
