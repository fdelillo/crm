# Development configuration for `crm serve` and `crm migrate`. Copy to .env (git-ignored) and adjust.
# Load it in your shell with:  set -a && . ./.env && set +a
# Nothing here is a real secret: the passwords match the development defaults of compose.yaml.

# --- Database (docker compose up -d postgres; make db-reset) ---------------------------------
# Runtime role (crm_app): no privileges of its own, switches to the company role per transaction.
DATABASE_URL="postgres://crm_app:crm_app_dev@localhost:5432/crm?sslmode=disable"
# Migration role (crm_owner): only `crm migrate` uses it.
DATABASE_MIGRATION_URL="postgres://crm_owner:crm_owner_dev@localhost:5432/crm?sslmode=disable"

# --- Secrets ----------------------------------------------------------------------------------
# Standard base64 of at least 32 random bytes. Generate one:  openssl rand -base64 32
AUTH_HMAC_KEY="REPLACE_WITH_openssl_rand_-base64_32"

# --- HTTPS in development: "full binary" mode (plan 10.5.1) -----------------------------------
# Needs `make dev-certs` first (mkcert). Open https://localhost:8443
APP_BASE_URL="https://localhost:8443"
HTTP_ADDR=":8443"
TLS_CERT_FILE=".certs/localhost.pem"
TLS_KEY_FILE=".certs/localhost-key.pem"

# Other modes (plan 10.5.1):
#   Vite + API:    APP_BASE_URL="https://localhost:5173" (same HTTP_ADDR and TLS_* as above)
#   Backend only (curl, no browser): APP_BASE_URL="https://localhost:8080", HTTP_ADDR=":8080" and
#   no TLS_CERT_FILE / TLS_KEY_FILE (plain HTTP; a browser will not keep the session).
# In production APP_BASE_URL is the public https:// URL and TLS_* must NOT be set.

# --- Optional (defaults shown) ----------------------------------------------------------------
# METRICS_ADDR="127.0.0.1:9090"
# SESSION_IDLE="24h"
# SESSION_ABSOLUTE="168h"
# APP_LINK_RESET="/reset-password"
# APP_LINK_VERIFY="/verify-email"
# APP_LINK_INVITATION="/accept-invitation"

# --- Used from later phases (email and files; compose.yaml starts Mailpit and MinIO) ------------
# SMTP_HOST="localhost"
# SMTP_PORT="1025"
# SMTP_FROM="no-reply@crm.local"
# S3_ENDPOINT="localhost:9000"
# S3_BUCKET="crm-dev"
